---
/**
 * Platform marks used across the homepage-v4 diagrams and destination pills.
 * One inline sprite so a mark is defined once and referenced by <use> wherever
 * it appears, instead of the same path being pasted into a dozen cards.
 * `wpv4-` prefixed so the ids cannot collide with any other sprite on the page.
 */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
  <symbol id="wpv4-linkedin" viewBox="0 0 24 24"><rect width="24" height="24" rx="4" fill="#0A66C2"></rect><text x="12" y="17.4" font-family="Inter,sans-serif" font-size="12.5" font-weight="700" fill="#fff" text-anchor="middle">in</text></symbol>
  <symbol id="wpv4-x" viewBox="0 0 24 24"><rect width="24" height="24" rx="4" fill="#0F1419"></rect><text x="12" y="17" font-family="Inter,sans-serif" font-size="13" font-weight="600" fill="#fff" text-anchor="middle">X</text></symbol>
  <symbol id="wpv4-instagram-solid" viewBox="0 0 24 24"><rect width="24" height="24" rx="5" fill="#D6336C"></rect><rect x="5.6" y="5.6" width="12.8" height="12.8" rx="4" fill="none" stroke="#fff" stroke-width="1.8"></rect><circle cx="12" cy="12" r="3.3" fill="none" stroke="#fff" stroke-width="1.8"></circle><circle cx="16.4" cy="7.7" r="1.1" fill="#fff"></circle></symbol>
  <symbol id="wpv4-instagram" viewBox="0 0 24 24"><rect x="1.5" y="1.5" width="21" height="21" rx="6" fill="none" stroke="#D6336C" stroke-width="2"></rect><circle cx="12" cy="12" r="4.6" fill="none" stroke="#D6336C" stroke-width="2"></circle><circle cx="17.6" cy="6.4" r="1.4" fill="#D6336C"></circle></symbol>
  <symbol id="wpv4-bluesky" viewBox="0 0 24 24"><rect width="24" height="24" rx="4" fill="#0285FF"></rect><path d="M12 15.6C10.2 12.4 7.6 9.8 5.4 8.6c-.9-.5-1.6.1-1.4 1.1.3 1.6 1.3 4.3 2.6 5.3 1 .8 2.6.9 4 .6-1.2.4-2.6 1-1.6 2.3.7.9 2.2 1.4 3 .1z" fill="#fff"></path><path d="M12 15.6c1.8-3.2 4.4-5.8 6.6-7 .9-.5 1.6.1 1.4 1.1-.3 1.6-1.3 4.3-2.6 5.3-1 .8-2.6.9-4 .6 1.2.4 2.6 1 1.6 2.3-.7.9-2.2 1.4-3 .1z" fill="#fff"></path></symbol>
  <symbol id="wpv4-youtube" viewBox="0 0 24 24"><rect y="3.5" width="24" height="17" rx="4.5" fill="#FF0000"></rect><path d="M10 8.4l6 3.6-6 3.6z" fill="#fff"></path></symbol>
  <symbol id="wpv4-google" viewBox="0 0 24 24"><path d="M22 12.2c0-.8-.1-1.4-.2-2H12v3.7h5.6c-.1 1-.8 2.4-2.2 3.4l3.4 2.6c2-1.9 3.2-4.6 3.2-7.7z" fill="#4285F4"></path><path d="M12 22.5c2.7 0 5-.9 6.8-2.4l-3.4-2.6c-.9.6-2.1 1-3.4 1-2.6 0-4.9-1.7-5.7-4.1l-3.5 2.7C4.6 20.3 8 22.5 12 22.5z" fill="#34A853"></path><path d="M6.3 14.4c-.2-.6-.3-1.3-.3-2s.1-1.4.4-2L2.8 7.7C2.1 9 1.7 10.5 1.7 12.2s.4 3.2 1.1 4.5z" fill="#FBBC05"></path><path d="M12 5.9c1.8 0 3.1.8 3.8 1.5l3-2.9C16.9 2.7 14.7 1.8 12 1.8 8 1.8 4.6 4 2.8 7.7l3.6 2.8C7.1 8.1 9.4 5.9 12 5.9z" fill="#EA4335"></path></symbol>
  <symbol id="wpv4-wordpress" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#21759B"></circle><text x="12" y="17" font-family="Georgia,serif" font-size="12" font-weight="700" fill="#fff" text-anchor="middle">W</text></symbol>
  <symbol id="wpv4-ai" viewBox="0 0 24 24"><rect width="24" height="24" rx="5" fill="#3F4A6B"></rect><path d="M12 5l1.5 4.2L18 10.7l-4.5 1.5L12 16.4l-1.5-4.2L6 10.7l4.5-1.5z" fill="#F2EFE6"></path><circle cx="17.4" cy="16.6" r="1.6" fill="#F2EFE6"></circle></symbol>
  <symbol id="wpv4-doc" viewBox="0 0 24 24"><rect x="4" y="2.5" width="16" height="19" rx="2" fill="#F2EFE6" stroke="#7A5C2E" stroke-width="1.4"></rect><path d="M7.5 8h9M7.5 11.5h9M7.5 15h6" stroke="#7A5C2E" stroke-width="1.3" stroke-linecap="round"></path></symbol>
  <symbol id="wpv4-star" viewBox="0 0 24 24"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.6l-5.9 3.2 1.2-6.6L2.5 9.6l6.6-.9z" fill="#C47A1C"></path></symbol>
  <symbol id="wpv4-facebook" viewBox="0 0 24 24"><rect width="24" height="24" rx="5" fill="#1877F2"></rect><path d="M14.6 12.6h-1.7V19h-2.6v-6.4H8.9v-2.2h1.4V8.9c0-1.6 1-2.7 2.8-2.7h1.7v2.2h-1.2c-.5 0-.7.2-.7.7v1.3h2z" fill="#fff"></path></symbol>
  <symbol id="wpv4-sanity" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#F03E2F"></circle><text x="12" y="16.8" font-family="Inter,sans-serif" font-size="12" font-weight="700" fill="#fff" text-anchor="middle">S</text></symbol>
  <symbol id="wpv4-astro" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#FF5D01"></circle><path d="M13.4 5.4l1.9 12.1-3.3 1.4-3.4-1.4z" fill="#fff"></path></symbol>
</defs></svg>
