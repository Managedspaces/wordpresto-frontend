---
/**
 * Hero column: eyebrow rule, the display headline, the two body lines, the
 * serif "how much help you want" line, both CTAs and the destination pills.
 */
import type { HomeV4Content } from '@/data/i18n/homeV4';

interface Props {
  hero: HomeV4Content['hero'];
  registerHref: string;
}
const { hero, registerHref } = Astro.props;
---

<div class="hero">
  <p class="hero-eyebrow">
    <span>{hero.eyebrow}</span>
    <span class="hero-rule"></span>
  </p>

  <h1 class="hero-h1">{hero.h1}</h1>

  {hero.body.map((line) => <p class="hero-body">{line}</p>)}

  <p class="hero-serif">{hero.serifLine}</p>

  <div class="hero-ctas">
    <a class="hero-cta hero-cta--primary" href={registerHref}>{hero.ctaPrimary}</a>
  </div>

  <p class="hero-note">{hero.trialNote}</p>

  <div class="hero-prepares">
    <span class="hero-prepares-label">{hero.preparesLabel}</span>
    <span class="hero-pills">
      {hero.preparesFor.map((name) => <span class="hero-pill">{name}</span>)}
    </span>
  </div>
</div>

<style>
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 24px;
    font-family: var(--wp-font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--wp-text-tertiary);
  }
  .hero-rule {
    flex: 1;
    height: 1px;
    background: var(--wp-border-primary);
  }
  .hero-h1 {
    font-family: var(--wp-font-serif);
    font-weight: 600;
    /* Scales from a comfortable phone size up to the design's 63px. */
    font-size: clamp(2.25rem, 4.3vw + 0.5rem, 3.9375rem);
    line-height: 1.02;
    letter-spacing: -0.032em;
    margin: 0;
    max-width: 19em;
  }
  .hero-body {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--wp-text-secondary);
    margin: 26px 0 0;
    max-width: 34em;
  }
  .hero-body + .hero-body {
    margin-top: 14px;
  }
  .hero-serif {
    font-family: var(--wp-font-serif);
    font-size: clamp(1.1875rem, 1.7vw + 0.5rem, 1.5rem);
    line-height: 1.34;
    margin: 22px 0 0;
    max-width: 22em;
  }
  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 46px tall: the design's large button, and a comfortable tap target. */
    min-height: 46px;
    padding: 0 22px;
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }
  .hero-cta--primary {
    background: var(--wp-primary);
    border: 1px solid var(--wp-primary);
    color: var(--wp-text-inverse);
  }
  .hero-cta--primary:hover {
    background: var(--wp-signal-hover);
    border-color: var(--wp-signal-hover);
    color: var(--wp-text-inverse);
  }
  .hero-cta:focus-visible {
    outline: 2px solid var(--wp-accent-ink);
    outline-offset: 3px;
  }
  .hero-note {
    font-family: var(--wp-font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--wp-text-muted);
    margin: 14px 0 0;
  }
  .hero-prepares {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1px solid var(--wp-border-primary);
  }
  .hero-prepares-label {
    font-family: var(--wp-font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--wp-text-muted);
  }
  .hero-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .hero-pill {
    font-family: var(--wp-font-mono);
    font-size: 11.5px;
    padding: 4px 9px;
    border: 1px solid var(--wp-border-primary);
    border-radius: var(--wp-radius-pill);
    color: var(--wp-text-secondary);
  }
</style>
